/* ────────────────────────────────────────────────────────────────────
 * MySpresso Artisan — global QSS stylesheet
 *
 * Loaded once at application startup by artisanlib.styles.apply_myspresso_stylesheet().
 * Dark mode rules use [theme="dark"] selectors; the loader toggles
 * QApplication's `theme` dynamic property based on system colour scheme.
 *
 * Selectors prefer property-based ([role="primary"]) over object names so
 * that any QPushButton can be opted-in with `btn.setProperty("role", ...)`
 * without renaming widgets across the codebase.
 *
 * This file is a TEMPLATE: colour values are placeholders (@token@ style,
 * uppercase names) resolved from artisanlib/design_tokens.py by
 * styles.load_qss() at startup. Never write a hex literal here —
 * add/extend a token instead.
 * ──────────────────────────────────────────────────────────────────── */


/* === Window & defaults =============================================== */
QWidget {
    background-color: @WARM_100@;        /* warm.100 */
    color: @NAVY_900@;                   /* navy.900 */
    font-family: "Montserrat", "Inter", -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: @WARM_100@;
}


/* === Buttons · Default (no role property) ============================ */
/* Generic baseline for the hundreds of buttons inside dialogs (including
 * those nested in QGroupBox, QFrame, QTabWidget, etc.). Applied to any
 * QPushButton that's a descendant of a QDialog OR a QGroupBox — covers
 * the legacy macOS-native rounded look that leaks through when the QSS
 * doesn't otherwise match. Buttons with inline setStyleSheet override
 * this (Artisan's pushbuttonstyles dict, etc.). Role-tagged buttons
 * (primary/secondary/danger) take precedence too. */
QDialog QPushButton,
QGroupBox QPushButton,
QTabWidget QPushButton,
QFrame QPushButton {
    background-color: @LIGHT_BG_RAISED@;
    color: @NAVY_900@;
    border: 1px solid @WARM_400@;
    border-radius: 2px;
    padding: 6px 14px;
    min-width: 72px;
    font-weight: 600;
}
QDialog QPushButton:hover,
QGroupBox QPushButton:hover,
QTabWidget QPushButton:hover,
QFrame QPushButton:hover         { background-color: @WARM_100@; }
QDialog QPushButton:pressed,
QGroupBox QPushButton:pressed,
QTabWidget QPushButton:pressed,
QFrame QPushButton:pressed       { background-color: @WARM_200@; }
QDialog QPushButton:disabled,
QGroupBox QPushButton:disabled,
QTabWidget QPushButton:disabled,
QFrame QPushButton:disabled      { color: @WARM_500@; border-color: @WARM_300@; }
QDialog QPushButton:default,
QGroupBox QPushButton:default,
QTabWidget QPushButton:default,
QFrame QPushButton:default {
    background-color: @NAVY_700@;
    color: @LIGHT_BG_RAISED@;
    border-color: @NAVY_700@;
}
QDialog QPushButton:default:hover,
QGroupBox QPushButton:default:hover,
QTabWidget QPushButton:default:hover,
QFrame QPushButton:default:hover { background-color: @NAVY_800@; }
QDialog QPushButton:default:pressed,
QGroupBox QPushButton:default:pressed,
QTabWidget QPushButton:default:pressed,
QFrame QPushButton:default:pressed { background-color: @NAVY_900@; }


/* === Buttons · Primary =============================================== */
QPushButton[role="primary"] {
    background-color: @NAVY_700@;
    color: @LIGHT_BG_RAISED@;
    border: none;
    border-radius: 2px;
    padding: 10px 18px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
QPushButton[role="primary"]:hover    { background-color: @NAVY_800@; }
QPushButton[role="primary"]:pressed  { background-color: @NAVY_900@; }
QPushButton[role="primary"]:disabled {
    background-color: @WARM_200@;
    color: @WARM_500@;
}
QPushButton[role="primary"]:focus {
    outline: none;
    border: 2px solid @NAVY_700@;
    padding: 8px 16px;
}


/* === Buttons · Destructive (DROP, dangerous actions) ================= */
QPushButton[role="danger"] {
    background-color: @RED_600@;
    color: @LIGHT_BG_RAISED@;
    border: none;
    border-radius: 2px;
    padding: 10px 18px;
    font-weight: 600;
    text-transform: uppercase;
}
QPushButton[role="danger"]:hover    { background-color: @RED_700@; }
QPushButton[role="danger"]:pressed  { background-color: @RED_800@; }
QPushButton[role="danger"]:disabled { background-color: @WARM_200@; color: @WARM_500@; }


/* === Buttons · Secondary (outlined) ================================== */
QPushButton[role="secondary"] {
    background-color: @LIGHT_BG_RAISED@;
    color: @NAVY_900@;
    border: 1px solid @WARM_400@;
    border-radius: 2px;
    padding: 10px 16px;
    font-weight: 600;
}
QPushButton[role="secondary"]:hover    { background-color: @WARM_100@; }
QPushButton[role="secondary"]:pressed  { background-color: @WARM_200@; }
QPushButton[role="secondary"]:disabled { color: @WARM_500@; border-color: @WARM_300@; }


/* === Buttons · Event (CHARGE, DRY, FCs, FCe, SCs, SCe, COOL, DROP) === */
/* Match Artisan's existing pushbuttonstyles state names via role+state.
 * The Python side calls setProperty("role","event") + setProperty("state",...)
 * then style().polish() to refresh.                                       */

QPushButton[role="event"] {
    background-color: @WARM_200@;
    color: @NAVY_700@;
    border: 1px solid @WARM_400@;
    border-radius: 2px;
    padding: 8px 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 12px;
}
QPushButton[role="event"]:hover    { background-color: @WARM_300@; }
QPushButton[role="event"]:pressed  { background-color: @WARM_400@; }
QPushButton[role="event"]:disabled { color: @WARM_500@; }
QPushButton[role="event"][state="active"]  { background-color: @NAVY_700@; color: @LIGHT_BG_RAISED@; border-color: @NAVY_700@; }
QPushButton[role="event"][state="charge"]  { background-color: @RED_600@; color: @LIGHT_BG_RAISED@; border-color: @RED_600@; }
QPushButton[role="event"][state="drop"]    { background-color: @RED_700@; color: @LIGHT_BG_RAISED@; border-color: @RED_700@; }


/* === Toolbar icon buttons ============================================ */
QToolButton,
QPushButton[role="icon"] {
    background-color: transparent;
    border: none;
    border-radius: 2px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}
QToolButton:hover,
QPushButton[role="icon"]:hover    { background-color: @WARM_200@; }
QToolButton:checked,
QPushButton[role="icon"]:checked  { background-color: @WARM_300@; color: @NAVY_700@; }
QToolButton:pressed,
QPushButton[role="icon"]:pressed  { background-color: @WARM_400@; }


/* === Status bar (persistent retention controlled in Python) ========== */
QStatusBar {
    background-color: @WARM_200@;
    color: @NAVY_900@;
    border-top: 1px solid @WARM_300@;
    font-family: "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    padding: 6px 12px;
}
QStatusBar[severity="success"] { border-left: 3px solid @SUCCESS_FG@; background-color: @SUCCESS_BG@; }
QStatusBar[severity="error"]   { border-left: 3px solid @RED_700@; background-color: @RED_100@; }
QStatusBar[severity="warn"]    { border-left: 3px solid @WARNING_FG@; background-color: @WARNING_BG@; }
QStatusBar[severity="info"]    { border-left: 3px solid @NAVY_700@; }


/* === Header strip (toolbar host) ===================================== */
#MysHeader {
    background-color: @LIGHT_BG_RAISED@;
    border-bottom: 1px solid @WARM_300@;
}
#MysHeader QLabel#brand {
    color: @RED_600@;
    font-size: 20px;
    font-weight: 700;
}


/* === Dialog ========================================================== */
/* v2 design: clean white card, warm border, square corners, generous
   padding. Every QDialog in the app inherits this — no per-dialog
   stylesheet needed. */
QDialog {
    background-color: @LIGHT_BG_RAISED@;
    border: 1px solid @WARM_300@;
    border-radius: 2px;
}
QDialog > QLabel,
QDialog QLabel {
    background-color: transparent;
}
QDialog QLabel[role="dialogTitle"] {
    font-size: 18px;
    font-weight: 700;
    color: @NAVY_900@;
    padding-bottom: 4px;
}
QDialog QLabel[role="dialogSubtitle"] {
    font-size: 13px;
    color: @WARM_600@;
    padding-bottom: 8px;
}
QDialog QLabel[role="section"] {
    font-size: 12px;
    font-weight: 700;
    color: @NAVY_900@;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding-top: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid @WARM_300@;
}
QDialog QLabel[role="formLabel"] {
    font-size: 10px;
    font-weight: 700;
    color: @WARM_600@;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

/* QGroupBox is what 90% of legacy Artisan dialogs use to section their
   content. Restyle title to match v2 — small uppercase dark navy on a
   thin warm divider line — and remove the noisy default GroupBox frame. */
QDialog QGroupBox,
QGroupBox {
    background-color: transparent;
    border: none;
    border-top: 1px solid @WARM_300@;
    margin-top: 24px;
    padding-top: 20px;
    font-size: 12px;
    font-weight: 700;
    color: @NAVY_900@;
    letter-spacing: 0.6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px 0 0;
    background-color: @WARM_100@;
    color: @NAVY_900@;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

/* Bottom button bar (QDialogButtonBox) — right-aligned secondary +
   primary trio per the mockup. */
QDialog QDialogButtonBox {
    button-layout: 3;  /* MacLayout: cancel | apply | accept */
    spacing: 8px;
    padding-top: 16px;
}


/* === Inputs ========================================================== */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit,
QDateTimeEdit,
QDateEdit,
QTimeEdit {
    background-color: @LIGHT_BG_RAISED@;
    color: @NAVY_900@;
    border: 1px solid @WARM_400@;
    border-radius: 2px;
    padding: 6px 10px;
    selection-background-color: @NAVY_700@;
    selection-color: @LIGHT_BG_RAISED@;
}
/* QComboBox: only ~4px extra padding-left so the displayed value isn't
   right against the border. Don't touch padding-right — the drop-down
   sub-control occupies that space and adding padding-right would push
   the text out of view in narrow combos (e.g. the kg/g unit selector). */
QComboBox {
    padding-left: 8px;
}
QLineEdit[mono="true"],
QSpinBox[mono="true"],
QDoubleSpinBox[mono="true"] {
    font-family: "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid @NAVY_700@;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: @WARM_200@;
    color: @WARM_500@;
}


/* === ComboBox dropdown =============================================== */
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: @LIGHT_BG_RAISED@;
    border: 1px solid @WARM_300@;
    selection-background-color: @WARM_100@;
    selection-color: @NAVY_700@;
    padding: 4px;
    outline: 0;
}
/* Individual items inside the QComboBox popup: give them enough vertical
   breathing room so short labels (kg, g, lb, oz) aren't cropped. */
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    min-height: 22px;
    color: @NAVY_900@;
    background-color: transparent;
}
QComboBox QAbstractItemView::item:selected {
    background-color: @WARM_100@;
    color: @NAVY_700@;
}
QComboBox QAbstractItemView::item:hover {
    background-color: @WARM_200@;
    color: @NAVY_700@;
}


/* === SpinBox / DoubleSpinBox up & down buttons ======================== */
/* The default Qt up/down arrows render dark-on-dark when the field has a
   tinted background (e.g. our coffee-marked fields, or the navy palette
   override). Force a clean look — small warm tab on the right with navy
   chevron arrows in vector form, always visible. */
QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateTimeEdit::up-button,
QDateEdit::up-button,
QTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid @WARM_300@;
    border-bottom: 1px solid @WARM_300@;
    background-color: @WARM_100@;
    border-top-right-radius: 2px;
}
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateTimeEdit::down-button,
QDateEdit::down-button,
QTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid @WARM_300@;
    background-color: @WARM_100@;
    border-bottom-right-radius: 2px;
}
QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover { background-color: @WARM_200@; }
QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed { background-color: @WARM_300@; }

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateTimeEdit::up-arrow,
QDateEdit::up-arrow,
QTimeEdit::up-arrow {
    image: url("../icons/myspresso/chevron-up.svg");
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateTimeEdit::down-arrow,
QDateEdit::down-arrow,
QTimeEdit::down-arrow {
    image: url("../icons/myspresso/chevron-down.svg");
    width: 10px;
    height: 10px;
}
QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled { opacity: 0.3; }


/* === Timer / hero labels ============================================= */
QLabel[role="timer"] {
    font-family: "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 72px;
    font-weight: 700;
    color: @NAVY_900@;
    letter-spacing: -2px;
}
QLabel[role="temperature"] {
    font-family: "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 32px;
    font-weight: 500;
    color: @RED_600@;
}
QLabel[role="title"] {
    font-size: 18px;
    font-weight: 600;
    color: @NAVY_900@;
}
QLabel[role="muted"] {
    color: @WARM_600@;
    font-size: 11px;
}


/* === Cloud connection badge ========================================== */
/* Text colour stays dark navy in both states — the leading dot (set via
   rich-text inline span in MySpressoHeader.set_connected) carries the
   semantic green/red.  Background tints the badge subtly.
   Tight padding so the box hugs the text + radius 2px (MySpresso DA:
   quasi-square cards). Soft drop-shadow added programmatically via
   QGraphicsDropShadowEffect in MySpressoHeader.__init__ (QSS has no
   box-shadow). */
QLabel#cloudBadge[connected="true"] {
    background-color: @SUCCESS_BG@;
    color: @NAVY_900@;
    padding: 3px 12px;
    border-radius: 2px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.05em;
}
QLabel#cloudBadge[connected="false"] {
    background-color: @RED_100@;
    color: @NAVY_900@;
    padding: 3px 12px;
    border-radius: 2px;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.05em;
}


/* === Tabs ============================================================ */
QTabBar::tab {
    background: transparent;
    color: @WARM_700@;
    padding: 10px 18px;
    border: none;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}
QTabBar::tab:selected {
    color: @NAVY_700@;
    border-bottom: 2px solid @RED_600@;
}
QTabBar::tab:hover:!selected {
    color: @NAVY_700@;
}
/* Airy tab content: breathing room between the tab frame and the
   controls inside — dialogs must never feel cramped. */
QTabWidget::pane {
    border: 1px solid @WARM_300@;
    top: -1px;
    padding: 14px 16px;
}

/* NOTE: QGroupBox is styled once, in the "Dialog sectioning" block above
   (divider-style title, no box frame). A second boxed QGroupBox rule used
   to live here and silently won the cascade — do not reintroduce one. */


/* === Checkbox / Radio ================================================ */
QCheckBox, QRadioButton {
    color: @NAVY_900@;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    border: 1px solid @WARM_400@;
    background-color: @LIGHT_BG_RAISED@;
    border-radius: 2px;
}
QRadioButton::indicator:unchecked { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    border: 1px solid @NAVY_700@;
    background-color: @NAVY_700@;
    border-radius: 2px;
}
QRadioButton::indicator:checked { border-radius: 8px; }


/* === Slider ========================================================== */
QSlider::groove:horizontal {
    height: 4px;
    background: @WARM_300@;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background: @NAVY_700@;
}
QSlider::sub-page:horizontal {
    background: @RED_600@;
    border-radius: 2px;
}


/* === Tables / Trees / Lists ========================================== */
QTableWidget, QTreeWidget, QListWidget, QTableView, QTreeView, QListView {
    background-color: @LIGHT_BG_RAISED@;
    alternate-background-color: @WARM_100@;
    border: 1px solid @WARM_300@;
    gridline-color: @WARM_300@;
    selection-background-color: @NAVY_050@;
    selection-color: @NAVY_700@;
    outline: 0;
}
QHeaderView::section {
    background-color: @WARM_200@;
    color: @WARM_700@;
    border: none;
    border-right: 1px solid @WARM_300@;
    border-bottom: 1px solid @WARM_300@;
    padding: 8px 12px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.5px;
}


/* === ScrollBar (subtle, warm) ======================================== */
QScrollBar:vertical {
    width: 10px;
    background: transparent;
}
QScrollBar::handle:vertical {
    background: @WARM_400@;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: @WARM_500@; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    height: 10px;
    background: transparent;
}
QScrollBar::handle:horizontal {
    background: @WARM_400@;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: @WARM_500@; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }


/* === Menus & ContextMenu ============================================= */
QMenu {
    background-color: @LIGHT_BG_RAISED@;
    border: 1px solid @WARM_300@;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px;
    color: @NAVY_900@;
}
QMenu::item:selected {
    background-color: @WARM_100@;
    color: @NAVY_700@;
}
QMenu::separator {
    height: 1px;
    background: @WARM_300@;
    margin: 4px 8px;
}


/* === Tooltip ========================================================= */
QToolTip {
    background-color: @NAVY_900@;
    color: @WARM_100@;
    border: none;
    padding: 6px 10px;
    font-size: 12px;
}


/* === DARK MODE ======================================================= */

[theme="dark"] QWidget {
    background-color: @DARK_BG@;
    color: @DARK_FG_PRIMARY@;
}
[theme="dark"] QDialog,
[theme="dark"] QMainWindow {
    background-color: @DARK_BG@;
}
[theme="dark"] #MysHeader {
    background-color: @DARK_BG_RAISED@;
    border-bottom: 1px solid @DARK_BORDER@;
}
[theme="dark"] QStatusBar {
    background-color: @DARK_BG_SUNKEN@;
    color: @DARK_FG_PRIMARY@;
    border-top: 1px solid @DARK_BORDER@;
}
[theme="dark"] QDialog QPushButton {
    background-color: @DARK_BG_RAISED@;
    color: @DARK_FG_PRIMARY@;
    border-color: @DARK_BORDER_STRONG@;
}
[theme="dark"] QDialog QPushButton:hover            { background-color: @DARK_SURFACE_ALT@; }
[theme="dark"] QDialog QPushButton:default          { background-color: @NAVY_500@; border-color: @NAVY_500@; }
[theme="dark"] QDialog QPushButton:default:hover    { background-color: @NAVY_600@; }
[theme="dark"] QPushButton[role="primary"]        { background-color: @NAVY_500@; }
[theme="dark"] QPushButton[role="primary"]:hover  { background-color: @NAVY_600@; }
[theme="dark"] QPushButton[role="danger"]         { background-color: @RED_400@; }
[theme="dark"] QPushButton[role="danger"]:hover   { background-color: @RED_600@; }
[theme="dark"] QPushButton[role="secondary"] {
    background-color: @DARK_BG_RAISED@;
    color: @DARK_FG_PRIMARY@;
    border-color: @DARK_BORDER_STRONG@;
}
[theme="dark"] QPushButton[role="secondary"]:hover { background-color: @DARK_SURFACE_ALT@; }
[theme="dark"] QPushButton[role="event"] {
    background-color: @DARK_BG_RAISED@;
    color: @DARK_FG_PRIMARY@;
    border-color: @DARK_BORDER_STRONG@;
}
[theme="dark"] QPushButton[role="event"]:hover    { background-color: @DARK_SURFACE_ALT@; }
[theme="dark"] QToolButton:hover,
[theme="dark"] QPushButton[role="icon"]:hover     { background-color: @DARK_SURFACE_ALT@; }
[theme="dark"] QLineEdit,
[theme="dark"] QComboBox,
[theme="dark"] QSpinBox,
[theme="dark"] QDoubleSpinBox,
[theme="dark"] QPlainTextEdit,
[theme="dark"] QTextEdit,
[theme="dark"] QDateTimeEdit {
    background-color: @DARK_BG_RAISED@;
    color: @DARK_FG_PRIMARY@;
    border-color: @DARK_BORDER_STRONG@;
}
[theme="dark"] QLineEdit:focus,
[theme="dark"] QComboBox:focus,
[theme="dark"] QSpinBox:focus,
[theme="dark"] QDoubleSpinBox:focus { border-color: @DARK_BORDER_FOCUS@; }
[theme="dark"] QComboBox QAbstractItemView {
    background-color: @DARK_BG_RAISED@;
    color: @DARK_FG_PRIMARY@;
    border-color: @DARK_BORDER_STRONG@;
    selection-background-color: @DARK_SURFACE_ALT@;
    selection-color: @DARK_FG_PRIMARY@;
}
[theme="dark"] QComboBox QAbstractItemView::item {
    color: @DARK_FG_PRIMARY@;
    background-color: transparent;
}
[theme="dark"] QComboBox QAbstractItemView::item:selected {
    background-color: @DARK_SURFACE_ALT@;
    color: @DARK_FG_PRIMARY@;
}
[theme="dark"] QComboBox QAbstractItemView::item:hover {
    background-color: @DARK_BORDER@;
    color: @DARK_FG_PRIMARY@;
}
[theme="dark"] QTabBar::tab           { color: @DARK_FG_SECONDARY@; }
[theme="dark"] QTabBar::tab:selected  { color: @DARK_FG_PRIMARY@; border-bottom-color: @RED_300@; }
[theme="dark"] QTabWidget::pane       { border-color: @DARK_BORDER@; }
[theme="dark"] QGroupBox              { border-top-color: @DARK_BORDER@; }
[theme="dark"] QGroupBox::title       {
    color: @DARK_FG_PRIMARY@;
    background-color: @DARK_BG@;
}
[theme="dark"] QDialog QLabel[role="dialogSubtitle"] { color: @DARK_FG_SECONDARY@; }
[theme="dark"] QDialog QLabel[role="section"]        {
    color: @DARK_FG_PRIMARY@;
    border-bottom-color: @DARK_BORDER@;
}
[theme="dark"] QDialog QLabel[role="formLabel"]      { color: @DARK_FG_SECONDARY@; }
[theme="dark"] QCheckBox::indicator:unchecked,
[theme="dark"] QRadioButton::indicator:unchecked {
    border-color: @DARK_BORDER_STRONG@;
    background-color: @DARK_BG_RAISED@;
}
[theme="dark"] QCheckBox::indicator:checked,
[theme="dark"] QRadioButton::indicator:checked {
    background-color: @NAVY_500@;
    border-color: @NAVY_500@;
}
[theme="dark"] QSlider::groove:horizontal { background: @DARK_BORDER@; }
[theme="dark"] QSlider::handle:horizontal { background: @DARK_FG_PRIMARY@; }
[theme="dark"] QSlider::sub-page:horizontal { background: @RED_400@; }
[theme="dark"] QTableWidget,
[theme="dark"] QTreeWidget,
[theme="dark"] QListWidget {
    background-color: @DARK_BG_RAISED@;
    alternate-background-color: @DARK_BG@;
    border-color: @DARK_BORDER@;
    gridline-color: @DARK_BORDER@;
    selection-background-color: @DARK_SURFACE_ALT@;
    selection-color: @DARK_FG_PRIMARY@;
}
[theme="dark"] QHeaderView::section {
    background-color: @DARK_BG_SUNKEN@;
    color: @DARK_FG_SECONDARY@;
    border-right-color: @DARK_BORDER@;
    border-bottom-color: @DARK_BORDER@;
}
[theme="dark"] QMenu {
    background-color: @DARK_BG_RAISED@;
    border-color: @DARK_BORDER@;
}
[theme="dark"] QMenu::item:selected   { background-color: @DARK_SURFACE_ALT@; color: @DARK_FG_PRIMARY@; }
[theme="dark"] QMenu::separator       { background: @DARK_BORDER@; }
[theme="dark"] QScrollBar::handle:vertical,
[theme="dark"] QScrollBar::handle:horizontal { background: @DARK_BORDER_STRONG@; }
[theme="dark"] QScrollBar::handle:vertical:hover,
[theme="dark"] QScrollBar::handle:horizontal:hover { background: @WARM_700@; }
[theme="dark"] QToolTip {
    background-color: @DARK_FG_PRIMARY@;
    color: @NAVY_900@;
}
[theme="dark"] QLabel[role="timer"]   { color: @DARK_FG_PRIMARY@; }
[theme="dark"] QLabel[role="temperature"] { color: @RED_300@; }
[theme="dark"] QLabel[role="muted"]   { color: @DARK_FG_MUTED@; }
[theme="dark"] QLabel#cloudBadge[connected="true"] {
    background-color: @DARK_SUCCESS_BG@;
    color: @DARK_SUCCESS_FG@;
}
[theme="dark"] QLabel#cloudBadge[connected="false"] {
    background-color: @DARK_ERROR_BG@;
    color: @RED_300@;
}
